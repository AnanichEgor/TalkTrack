.build/
.DS_Store
xcuserdata/
*.xcuserstate
.swiftpm/
!.swiftpm/configuration/

# The default meeting library lives in this folder; never commit recordings.
/.talktrack-library/
/.agents/
/.claude/
/.idea/
/openspec/

# Local-only files
__pycache__/
*.pyc
/docs/SESSION_HANDOFF.md

# Developer-only material kept locally, not published:
# agent notes, the original brief, validation evidence, debug screens,
# model/storage fixture programs and their runner scripts.
/AGENTS.md
/prompt.md
/docs/validation/
/project.devtools.yml
# The project is generated by XcodeGen; only the dependency lockfile is kept.
/TalkTrack.xcodeproj/*
!/TalkTrack.xcodeproj/project.xcworkspace/
/TalkTrack.xcodeproj/project.xcworkspace/*
!/TalkTrack.xcodeproj/project.xcworkspace/xcshareddata/
/TalkTrack.xcodeproj/project.xcworkspace/xcshareddata/*
!/TalkTrack.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/TalkTrack.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/TalkTrack.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
/Fixtures/Inference/
/Fixtures/PermissionProbe/
/Packages/TalkTrackKit/Sources/TalkTrackStorageFixture/
/Packages/TalkTrackKit/Sources/TalkTrackAudioStorageFixture/
/App/AudioCaptureCheckView.swift
/App/LiveTranscriptionCheckView.swift
/App/SavedSpeakersCheckView.swift
/App/SpeakerRenameCheckView.swift
/App/ReviewSupport.swift
/scripts/*
!/scripts/build.sh
!/scripts/launch.sh
!/scripts/test.sh
!/scripts/package.sh
!/scripts/resolve-dependencies.sh
!/scripts/audit-inference.py
!/scripts/fetch-model-metadata.py
!/scripts/generate-model-catalog.py
!/scripts/make-app-icon.swift
